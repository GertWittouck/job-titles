<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging configuration. Set the com.feefo level to DEBUG to see every match, or TRACE to see all candidate scores. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %c{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.feefo" level="INFO"/>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
